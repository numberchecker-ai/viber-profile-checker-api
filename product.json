{
  "name": "Viber Profile Checker API",
  "brand": "NumberChecker",
  "repository": "numberchecker-ai/viber-profile-checker-api",
  "description": "Asynchronous bulk Viber verification API for NumberChecker.",
  "official_site": "https://numberchecker.ai",
  "landing_page": "https://numberchecker.ai/products/viber-profile-checker",
  "canonical_docs": "https://docs.numberchecker.ai/viber-senior-checker",
  "base_url": "https://api.numberchecker.ai",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async",
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "format": "text",
    "one_per_line": true,
    "input_kind": "phone"
  },
  "products": [
    {
      "type": "viber_senior",
      "name": "Profile Checker",
      "min": 1,
      "max": 10000000,
      "fields": [
        "number",
        "activated",
        "last_online_time",
        "active_days",
        "mid",
        "nickname",
        "person_count",
        "avatar_type",
        "age",
        "skin_color",
        "gender",
        "avatar"
      ],
      "product_id": 30,
      "min_billable_numbers": 500,
      "available": true
    }
  ],
  "pricing_url": "https://numberchecker.ai/pricing",
  "maintainer": "NumberChecker",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
